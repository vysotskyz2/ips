# Конфигурация приложения «Кадастровая карта Республики Беларусь»

# Для PostgreSQL + PostGIS (Docker):
# DATABASE_URL=postgresql+asyncpg://cadastral:cadastral_pass@localhost:5432/belarus_cadastral

# Для локального SQLite:
DATABASE_URL=sqlite+aiosqlite:///./cadastral_rb.db

# Загрузка зданий/организаций из OpenStreetMap API v0.6 по клику
ENABLE_LIVE_OSM_ENRICHMENT=true

# Обогащение действующими и исключёнными субъектами ЕГР по адресу
ENABLE_EGR_ENRICHMENT=true

# Проверка отдельных записей ЕГР по УНП через egr.gov.by (по умолчанию выключена:
# публичный endpoint для отдельных УНП часто отвечает 204)
ENABLE_LIVE_EGR_VERIFICATION=false

# Уточнение города через Nominatim при отсутствии addr:city в OSM
ENABLE_LIVE_REVERSE_GEOCODING=true

# Импорт выделенной области: размер тайла OSM (градусы), лимит тайлов и параллельность
AREA_IMPORT_TILE_SIZE_DEG=0.008
AREA_IMPORT_MAX_TILES=120
AREA_IMPORT_MAX_FETCH_CONCURRENCY=1

# Вспомогательные внешние URL
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
GEOFABRIK_BELARUS_PBF_URL=https://download.geofabrik.de/europe/belarus-latest.osm.pbf
